{
  "name": "jr",
  "productName": "JR",
  "version": "0.1.1",
  "description": "JR, a plugin toolkit for Animal Jam Classic by BradysLabs.",
  "author": "BradysLabs",
  "license": "MIT",
  "private": true,
  "main": "src/main/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "release": "electron-builder build --win --publish always",
    "build:mac": "electron-builder build --mac --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BradysLabs/JR.git"
  },
  "build": {
    "appId": "com.bradyslabs.jr",
    "productName": "JR",
    "copyright": "Copyright (c) 2026 BradysLabs",
    "artifactName": "JR-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "plugins/**/*",
      "data/worth/values.json",
      "data/worth/image-colors.json",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "plugins/**/*",
      "assets/**/*",
      "data/worth/values.json"
    ],
    "afterPack": "tools/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "JR"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "JR-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "JR ${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "BradysLabs",
      "repo": "JR"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
